{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DBOARD_HAS_PSRAM",
      "-mfix-esp32-psram-cache-issue",
      "-DUSER_SETUP_LOADED=1",
      "-DST7789_DRIVER=1",
      "-DTFT_BACKLIGHT_ON=HIGH",
      "-DTFT_BL=14",
      "-DTFT_MISO=-1",
      "-DTFT_MOSI=11",
      "-DTFT_SCLK=12",
      "-DTFT_CS=10",
      "-DTFT_DC=13",
      "-DTFT_RST=9",
      "-DSPI_FREQUENCY=40000000",
      "-DSPI_READ_FREQUENCY=20000000",
      "-DTOUCH_I2C=1",
      "-DTOUCH_SDA=17",
      "-DTOUCH_SCL=18",
      "-DTOUCH_INT=15",
      "-DTOUCH_RST=16",
      "-DCYD_SCREEN_HEIGHT_PX=240",
      "-DCYD_SCREEN_WIDTH_PX=320",
      "-DCYD_SCREEN_GAP_PX=8",
      "-DCYD_SCREEN_MIN_BUTTON_HEIGHT_PX=35",
      "-DCYD_SCREEN_MIN_BUTTON_WIDTH_PX=35",
      "-DCYD_SCREEN_FONT=lv_font_montserrat_14",
      "-DCYD_SCREEN_FONT_SMALL=lv_font_montserrat_10",
      "-DCYD_SCREEN_SIDEBAR_SIZE_PX=40",
      "-DCYD_SCREEN_DRIVER_FREENOVE_ESP32_S3=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },
  "connectivity": ["wifi", "bluetooth"],
  "frameworks": ["arduino", "espidf"],
  "name": "Freenove-ESP32-S3-28",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600
  },
  "vendor": "Freenove"
